  "about": {
    "breadcrumb": {
      "module": "CARGOMIND ARCHITECTURE",
      "subtitle": "SYSTEM MANIFESTO & SPECIFICATION",
      "version": "SYS.V.3.0 // RELEASE"
    },
    "hero": {
      "label": "LOGISTICS MANIFESTO & BLUEPRINT",
      "headline": "Fair, multi-modal freight intelligence",
      "headlineBold": "for rural and remote communities.",
      "description": "Bridging the critical gap between smallholder farmers, healthcare clinics, and regional markets with decentralized combinatorial algorithms, physics-based cold-chain kinetics, and provable non-deprioritization equity."
    },
    "pillars": {
      "p1": {
        "label": "PILLAR 01 // DYNAMIC MATCHING",
        "title": "Continuous Allocation",
        "description": "Dynamically matches pickups and vehicles as they appear, optimizing for urgency (critical medicines > perishable produce > routine goods), road conditions, vehicle payload, and cost.",
        "metric": "MATCHING LATENCY: < 15ms"
      },
      "p2": {
        "label": "PILLAR 02 // PROVABLE FAIRNESS",
        "title": "Starvation Prevention",
        "description": "Every pickup query draws from historical community wait times. Producers with extended wait times receive automated fairness boosts (+15pts/hour) to guarantee equitable access.",
        "metric": "REGIONAL FAIRNESS INDEX: 0.96"
      },
      "p3": {
        "label": "PILLAR 03 // OFFLINE RESILIENCE",
        "title": "Store-and-Forward Sync",
        "description": "Field agents and drivers can register shipments, log road hazards, and record temperature telemetry completely offline with automatic conflict-free synchronization upon reconnection.",
        "metric": "IDEMPOTENT SYNC: CLIENT-ID BACKED"
      }
    },
    "architecture": {
      "label": "SYSTEM ARCHITECTURE",
      "title": "The Rural Last-Mile Dispatch Architecture",
      "steps": {
        "s01": {
          "step": "01. COMMUNITY NODES",
          "title": "Village Aggregation Points",
          "description": "Producers drop produce and health sub-centres queue vaccines at solar-powered aggregation points and decentralized cold stores."
        },
        "s02": {
          "step": "02. TERRAIN SURVEILLANCE",
          "title": "Road Condition Feeds",
          "description": "Real-time terrain monitoring tracks unpaved mud tracks, seasonal washouts, and flood hazards to select capable vehicles."
        },
        "s03": {
          "step": "03. MULTI-OBJECTIVE SOLVER",
          "title": "Urgency & Fairness Optimization",
          "description": "CP-SAT solver matches pickups to available tempos, tractors, autos, and motorbikes with hard cold-chain validation for medicines."
        },
        "s04": {
          "step": "04. TRANSPARENT AUDIT",
          "title": "Explainable Allocation Feed",
          "description": "Publishes plain-language rationales for every match and logs community wait-time metrics for cooperative oversight."
        }
      }
    },
